\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Main quantitative comparison. We report the full CHORD configuration against external decode-time baselines. For each model we report average POPE F1 across the three splits, POPE Adversarial F1, CHAIR sentence/image hallucination ratios, MMBench accuracy, and per-token inference latency (ITL, ms/token). Lower ($\downarrow $) CHAIR and ITL are better; higher ($\uparrow $) POPE/MMBench are better. Bold indicates the best result in each column. Internal CHORD operating points are analyzed separately in \hyperref  [tab:family_tradeoff]{Table\nonbreakingspace \ref *{tab:family_tradeoff}} and \hyperref  [tab:operating_points]{Table\nonbreakingspace \ref *{tab:operating_points}}.}}{6}{table.caption.7}\protected@file@percent }
\newlabel{tab:main_results}{{1}{6}{Main quantitative comparison. We report the full CHORD configuration against external decode-time baselines. For each model we report average POPE F1 across the three splits, POPE Adversarial F1, CHAIR sentence/image hallucination ratios, MMBench accuracy, and per-token inference latency (ITL, ms/token). Lower ($\downarrow $) CHAIR and ITL are better; higher ($\uparrow $) POPE/MMBench are better. Bold indicates the best result in each column. Internal CHORD operating points are analyzed separately in \Tref {tab:family_tradeoff} and \Tref {tab:operating_points}}{table.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Qualitative Analysis and Trajectory Visualization}{6}{subsection.4.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Operating-Point Synthesis}{6}{subsection.4.4}\protected@file@percent }
\newlabel{sec:efficiency}{{4.4}{6}{Operating-Point Synthesis}{subsection.4.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Design evidence for CHORD. Top: decoder-to-vision heatmaps under three layer-selection choices, showing why CHORD uses the `last-4' window. Bottom-left: representative current-support scores for competing candidates at the admission step. Bottom-right: representative rollout utility traces showing how future arbitration separates a stable continuation from a text-dominated branch.}}{6}{figure.caption.8}\protected@file@percent }
\newlabel{fig:design_evidence}{{3}{6}{Design evidence for CHORD. Top: decoder-to-vision heatmaps under three layer-selection choices, showing why CHORD uses the `last-4' window. Bottom-left: representative current-support scores for competing candidates at the admission step. Bottom-right: representative rollout utility traces showing how future arbitration separates a stable continuation from a text-dominated branch}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Trace-backed qualitative evidence on four POPE-style cases. Panels (a)--(c) expose real rejected opener candidates suppressed during decoding, while panel (d) is reported as a hard-negative decision case without token-level trace annotation. Together they show how CHORD preserves grounded admissions and blocks weakly grounded continuations.}}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:qualitative_cases}{{4}{7}{Trace-backed qualitative evidence on four POPE-style cases. Panels (a)--(c) expose real rejected opener candidates suppressed during decoding, while panel (d) is reported as a hard-negative decision case without token-level trace annotation. Together they show how CHORD preserves grounded admissions and blocks weakly grounded continuations}{figure.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces POPE Adversarial precision-recall breakdown for representative baselines and the two main CHORD operating points. `CHORD-P+C' primarily improves robustness by raising precision without a large recall collapse, which is consistent with a better admission rule rather than a merely more conservative decoder.}}{7}{table.caption.11}\protected@file@percent }
\newlabel{tab:adv_breakdown}{{2}{7}{POPE Adversarial precision-recall breakdown for representative baselines and the two main CHORD operating points. `CHORD-P+C' primarily improves robustness by raising precision without a large recall collapse, which is consistent with a better admission rule rather than a merely more conservative decoder}{table.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Trade-off within the CHORD family across both backbones. `Past' is the lowest-latency correction, `Past+Current' gives the best efficiency-quality compromise, and `Full CHORD' gives the strongest overall quality metrics.}}{7}{table.caption.12}\protected@file@percent }
\newlabel{tab:family_tradeoff}{{3}{7}{Trade-off within the CHORD family across both backbones. `Past' is the lowest-latency correction, `Past+Current' gives the best efficiency-quality compromise, and `Full CHORD' gives the strongest overall quality metrics}{table.caption.12}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}Component Trade-off Within the CHORD Family}{7}{subsection.4.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Deployment-oriented operating-point summary relative to Greedy. Negative $\mitDelta $CH values indicate hallucination reduction; positive $\mitDelta $ITL indicates extra latency. Higher $\mitDelta $Adv.\ F1/$\mitDelta $MMB are better, lower $\mitDelta $CH are better.}}{7}{table.caption.13}\protected@file@percent }
\newlabel{tab:operating_points}{{4}{7}{Deployment-oriented operating-point summary relative to Greedy. Negative $\Delta $CH values indicate hallucination reduction; positive $\Delta $ITL indicates extra latency. Higher $\Delta $Adv.\ F1/$\Delta $MMB are better, lower $\Delta $CH are better}{table.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Quantitative synthesis of the main tables. (a,b) Adversarial F1 versus ITL. (c,d) CHAIR$_S$ versus MMBench with marker area proportional to ITL. The plots separate the efficiency-oriented `CHORD-P+C' regime from quality-oriented Full CHORD.}}{8}{figure.caption.10}\protected@file@percent }
\newlabel{fig:quantitative}{{5}{8}{Quantitative synthesis of the main tables. (a,b) Adversarial F1 versus ITL. (c,d) CHAIR$_S$ versus MMBench with marker area proportional to ITL. The plots separate the efficiency-oriented `CHORD-P+C' regime from quality-oriented Full CHORD}{figure.caption.10}{}}
